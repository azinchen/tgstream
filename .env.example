# Copy to .env and adjust.

# Timezone - MUST be identical for mediamtx and the capture containers:
# recording segments are selected by local-time filename timestamps.
TZ=Etc/UTC

# Host/IP that resolves from Plex, Jellyfin AND playback clients.
PUBLIC_HOST=192.168.1.10

# Host paths (any locations work; these follow the /tank convention):
# - APPDATA_DIR holds the browser session, per-channel state and the rolling
#   recording segments. Not media; keep it out of Plex libraries.
# - LIBRARY_DIR is where finished recordings land; add it to Plex/Jellyfin
#   as a normal TV Shows library.
APPDATA_DIR=/tank/appdata/tgstream
LIBRARY_DIR=/tank/media/telegram

# Channel for tg-main: channel id, @username, or t.me/+invite URL.
TG_PEER=@yourchannel
TG_NAME=Telegram Main
