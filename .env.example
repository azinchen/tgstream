# Copy to .env and adjust.

# Timezone.
TZ=Etc/UTC

# Run the capture process as this uid:gid; recordings in LIBRARY_DIR are
# created with this ownership. 0:0 (default) runs as root.
PUID=1000
PGID=1000

# Host/IP that resolves from Plex, Jellyfin AND playback clients.
PUBLIC_HOST=192.168.1.10

# Telegram API credentials (create an app at https://my.telegram.org ->
# API development tools). One pair is fine for all channels.
API_ID=0000000
API_HASH=00000000000000000000000000000000

# Host paths:
# - APPDATA_DIR holds each channel's MTProto session + slate (not media).
# - LIBRARY_DIR is where finished recordings land; add it to Plex/Jellyfin
#   as a normal TV Shows library.
APPDATA_DIR=/tank/appdata/tgstream
LIBRARY_DIR=/tank/media/telegram

# Channel for tg-main: channel id, @username, or t.me/+invite URL.
TG_PEER=@yourchannel
TG_NAME=Telegram Main
