#!/bin/sh
# shellcheck shell=sh
# Shared helpers sourced by the entrypoint and every s6 service script.

trim()
{
    _t="$1"
    _t="${_t#"${_t%%[![:space:]]*}"}"
    _t="${_t%"${_t##*[![:space:]]}"}"
    printf '%s' "$_t"
}

log()
{
    script_name="${1:-unknown}"
    shift
    printf "%s [%s] %s\n" "$(date +'%Y-%m-%d %H:%M:%S')" "${script_name}" "$*"
}

log_error()
{
    script_name="${1:-unknown}"
    shift
    printf "%s [%s] [ERROR] %s\n" "$(date +'%Y-%m-%d %H:%M:%S')" "${script_name}" "$*" >&2
}

log_warning()
{
    script_name="${1:-unknown}"
    shift
    printf "%s [%s] [WARNING] %s\n" "$(date +'%Y-%m-%d %H:%M:%S')" "${script_name}" "$*"
}

# Halt the service permanently on unrecoverable misconfiguration instead of
# letting s6 restart-loop it; the log line stays as the visible diagnosis.
die()
{
    log_error "$1" "CRITICAL ERROR: $2 - sleeping infinite"
    sleep infinity
}
