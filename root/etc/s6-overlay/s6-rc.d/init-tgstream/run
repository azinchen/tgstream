#!/command/with-contenv sh
# shellcheck shell=sh

set -eu

. /usr/local/bin/backend-functions

SCRIPT_NAME="INIT-TGSTREAM"

log "$SCRIPT_NAME" "Preparing runtime directories"
mkdir -p "${PULSE_RUNTIME_PATH:-/run/pulse}"

TG_SLUG="${TG_SLUG:-}"
TG_PEER="${TG_PEER:-}"

[ -n "$TG_SLUG" ] || die "$SCRIPT_NAME" "TG_SLUG is required"
[ -n "$TG_PEER" ] || die "$SCRIPT_NAME" "TG_PEER is required"
case "$TG_SLUG" in
    *[!a-z0-9-]*) die "$SCRIPT_NAME" "TG_SLUG must match [a-z0-9-] (got '${TG_SLUG}')" ;;
esac

# The Telegram session lives in this container's own browser profile; the
# integrated QR login (capture.py) fills it on first start and it persists
# on the /state volume from then on.
mkdir -p /state/profile

make-slate

log "$SCRIPT_NAME" "Initialization completed for channel '${TG_SLUG}'"
exit 0
