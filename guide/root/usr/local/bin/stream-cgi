#!/bin/sh
# shellcheck shell=sh
# CGI: remux a channel's stream to raw MPEG-TS for Plex's HDHomeRun client.
# Copy-remux only (no re-encode); ffmpeg dies on SIGPIPE when Plex hangs up.
# Query: path=tg-<slug>

path="${QUERY_STRING#*path=}"
path="${path%%&*}"

case "$path" in
    ""|*[!a-z0-9-]*)
        printf 'Status: 400 Bad Request\r\n\r\n'
        exit 0
        ;;
esac

printf 'Content-Type: video/mp2t\r\n\r\n'

exec ffmpeg -hide_banner -loglevel error \
    -fflags nobuffer \
    -i "${STREAM_SOURCE_BASE:-rtmp://tgstream-mediamtx:1935}/${path}" \
    -c copy -f mpegts -
